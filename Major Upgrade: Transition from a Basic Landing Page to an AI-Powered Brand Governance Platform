.compliance-workspace{background:#fff;border:1px solid var(--border);border-radius:20px;padding:clamp(18px,3vw,30px);box-shadow:0 12px 35px #26123c0a}
.compliance-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
