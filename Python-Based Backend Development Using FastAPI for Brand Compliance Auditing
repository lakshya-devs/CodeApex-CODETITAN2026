from fastapi import FastAPI, UploadFile, File, Form
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import pytesseract
from PIL import Image
import PyPDF2
import io
import re

app = FastAPI(title="VerityBrand API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], 
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

RULES = [
    {
        "category": "Factual & Claims",
        "type": "Unsupported Metric",
        "rule": "ASCI Regulation 1.4",
        "trigger": r"\b(100%|guaranteed|500%|\d{2,3}%)\b",
        "explanation": "Specific performance metrics and guarantees must be backed by documented audit evidence.",
        "suggestion": "proven to significantly improve enterprise efficiency"
    },
    {
        "category": "Tone & Voice",
        "type": "Absolute Claim",
        "rule": "VerityBrand Voice Standards",
        "trigger": r"\b(completely eliminates|zero setup|perfect)\b",
        "explanation": "Avoid absolute claims. Responsible governance requires disclosing realistic system boundaries.",
        "suggestion": "provides high-precision automated checks"
    },
    {
        "category": "Accessibility",
        "type": "Urgency Pressure",
        "rule": "WCAG 2.2 / Content Ethics",
        "trigger": r"\b(immediately|urgent|now)\b",
        "explanation": "High-pressure call-to-action language violates neutral tone guidelines and accessibility cognitive standards.",
        "suggestion": "at your earliest convenience"
    }
]

def analyze_text(text: str):
    issues = []
    score = 100
    
    for rule in RULES:
        matches = re.finditer(rule["trigger"], text, re.IGNORECASE)
        for match in matches:
            flagged = match.group(0)
            issues.append({
                "id": len(issues) + 1,
                "category": rule["category"],
                "type": rule["type"],
                "rule": rule["rule"],
                "flaggedText": flagged,
                "explanation": rule["explanation"],
                "suggestion": rule["suggestion"]
            })
            score -= 10 

    return {"score": max(0, score), "issues": issues, "extracted_text": text}

@app.post("/audit")
async def audit_content(
    text: str = Form(None),
    file: UploadFile = File(None)
):
    content_to_analyze = ""

    if file:
        content_bytes = await file.read()
        if file.content_type.startswith('image/'):
            image = Image.open(io.BytesIO(content_bytes))
            content_to_analyze = pytesseract.image_to_string(image)
        elif file.content_type == 'application/pdf':
            reader = PyPDF2.PdfReader(io.BytesIO(content_bytes))
            for page in reader.pages:
                content_to_analyze += page.extract_text()
    
    elif text:
        content_to_analyze = text

    if not content_to_analyze:
        return {"error": "No valid text or file provided"}

    results = analyze_text(content_to_analyze)
    return results

