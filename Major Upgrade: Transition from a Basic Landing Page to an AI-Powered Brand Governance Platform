.compliance-workspace textarea{width:100%;min-height:150px;resize:vertical;border:1px solid #e3d9eb;border-radius:12px;padding:13px;font:13px/1.65 Inter,sans-serif;background:#fcfaff;color:var(--ink)}
.compliance-workspace textarea:focus{outline:2px solid #d9c2f2;border-color:var(--purple)}
